[Unit]
Description=Forward Claude socks socket to residential bridge
Requires=claude-bridge.service
After=claude-bridge.service
[Service]
User=claude-relay
Group=claude-relay
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:7891
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
