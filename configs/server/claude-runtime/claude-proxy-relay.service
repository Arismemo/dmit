[Unit]
Description=Claude namespace proxy socket relay
Requires=claude-netns.service claude-http-egress.socket claude-socks-egress.socket
After=claude-netns.service claude-http-egress.socket claude-socks-egress.socket
[Service]
User=claude
Group=claude
NetworkNamespacePath=/run/netns/claude
ExecStart=/usr/local/libexec/claude-proxy-relay
ExecStartPost=/usr/local/libexec/claude-wait-ports 7890 7891
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
