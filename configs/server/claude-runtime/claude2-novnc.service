[Unit]
Description=Forward loopback novnc to isolated desktop
Requires=claude2-desktop.service
After=claude2-desktop.service
[Service]
User=claude2
Group=claude2
NetworkNamespacePath=/run/netns/claude2
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:6081
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
