#!/usr/bin/python3
import json
import os
import pathlib
import secrets
import signal
import subprocess
import time

cfg = json.loads(pathlib.Path('/etc/claude-runtime.json').read_text())
home = cfg['runtime_home']
os.umask(0o077)
os.environ.update({'HOME': home, 'DISPLAY': ':99', 'XAUTHORITY': home + '/.Xauthority',
                  'NO_PROXY': 'localhost,127.0.0.1,::1', 'no_proxy': 'localhost,127.0.0.1,::1'})
for name in ('HTTP_PROXY', 'HTTPS_PROXY', 'http_proxy', 'https_proxy'):
    os.environ[name] = cfg['http_proxy']
for name in ('ALL_PROXY', 'all_proxy'):
    os.environ[name] = cfg['socks_proxy']
pathlib.Path(os.environ['XAUTHORITY']).touch(mode=0o600)
subprocess.run(['xauth', '-f', os.environ['XAUTHORITY']],
               input=f'add :99 . {secrets.token_hex(16)}\n'.encode(),
               stdout=subprocess.DEVNULL, check=True)
children = []
def launch(args):
    process = subprocess.Popen(args)
    children.append(process)
    return process
def stop(*_):
    raise SystemExit(0)
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    launch(['Xvfb', ':99', '-screen', '0', '1366x768x24', '-nolisten', 'tcp',
            '-auth', os.environ['XAUTHORITY']])
    for attempt in range(50):
        if subprocess.run(['xdpyinfo'], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            break
        time.sleep(0.1)
    else:
        raise RuntimeError('X display did not become ready')
    launch(['autocutsel', '-selection', 'CLIPBOARD'])
    launch(['autocutsel', '-selection', 'PRIMARY'])
    launch(['x11vnc', '-display', ':99', '-auth', os.environ['XAUTHORITY'],
            '-localhost', '-forever', '-shared', '-nopw', '-rfbport', '5900'])
    launch(['/usr/bin/python3', '/usr/bin/websockify', '--web=/usr/share/novnc',
            '127.0.0.1:6080', '127.0.0.1:5900'])
    launch(['/opt/claude-browser/chrome', '--remote-debugging-port=9222',
            '--user-data-dir=' + home + '/browser-profile', '--no-first-run',
            '--no-default-browser-check', '--window-size=1366,768',
            '--disable-features=Translate', '--lang=en-US', '--disable-dev-shm-usage',
            '--proxy-server=' + cfg['http_proxy'], '--restore-last-session'])
    while all(process.poll() is None for process in children):
        time.sleep(1)
    raise RuntimeError('A desktop process exited')
finally:
    for process in reversed(children):
        if process.poll() is None:
            process.terminate()
    for process in children:
        try:
            process.wait(timeout=8)
        except subprocess.TimeoutExpired:
            process.kill()
