UVICORN_HOST=0.0.0.0
UVICORN_PORT=<MARZBAN_PORT>
UVICORN_SSL_CERTFILE="/etc/letsencrypt/live/<DOMAIN>/fullchain.pem"
UVICORN_SSL_KEYFILE="/etc/letsencrypt/live/<DOMAIN>/privkey.pem"

SUDO_USERNAME=<MARZBAN_ADMIN_USER>
SUDO_PASSWORD=<MARZBAN_ADMIN_PASS>

XRAY_JSON="/var/lib/marzban/xray_config.json"
XRAY_SUBSCRIPTION_URL_PREFIX="https://<DOMAIN>:<MARZBAN_PORT>"
TELEGRAM_DEFAULT_VLESS_FLOW="xtls-rprx-vision"

CUSTOM_TEMPLATES_DIRECTORY="/var/lib/marzban/templates/"
CLASH_SUBSCRIPTION_TEMPLATE="clash/custom.yml"
SUB_PROFILE_TITLE="DMIT-LA"

SQLALCHEMY_DATABASE_URL="sqlite:////var/lib/marzban/db.sqlite3?timeout=30"
